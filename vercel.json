{
  "buildCommand": "node scripts/build.mjs",
  "outputDirectory": "dist",
  "functions": {
    "api/property.js": {
      "includeFiles": "public/stays/property-template.html"
    }
  },
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/properties/:slug",
      "destination": "/api/property?slug=:slug"
    },
    {
      "source": "/properties/:slug/",
      "destination": "/api/property?slug=:slug"
    },
    {
      "source": "/locations/:slug",
      "destination": "/api/location?slug=:slug"
    },
    {
      "source": "/locations/:slug/",
      "destination": "/api/location?slug=:slug"
    }
  ]
}
